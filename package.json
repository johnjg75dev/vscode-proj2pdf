{
  "name": "vsc-project2pdf",
  "displayName": "Project Source Exporter",
  "description": "Export all source code in your project to a PDF (with syntax highlighting, TOC, folder tree, page numbers) or copy it to the clipboard.",
  "version": "1.2.2",
  "publisher": "johnjg75dev",
  "repository": "https://github.com/johnjg75dev/vscode-proj2pdf/",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pdf",
    "export",
    "print",
    "source code",
    "clipboard",
    "llm"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "projectExporter.export",
        "title": "Export Project Source...",
        "category": "Project Exporter",
        "icon": "$(export)"
      },
      {
        "command": "projectExporter.exportPdf",
        "title": "Export Project Source to PDF",
        "category": "Project Exporter"
      },
      {
        "command": "projectExporter.copyToClipboard",
        "title": "Copy Project Source to Clipboard",
        "category": "Project Exporter"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "projectExporter.exportPdf",
          "when": "explorerResourceIsFolder",
          "group": "7_projectExporter@1"
        },
        {
          "command": "projectExporter.copyToClipboard",
          "when": "explorerResourceIsFolder",
          "group": "7_projectExporter@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "projectExporter.export",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "Project Source Exporter",
      "properties": {
        "projectExporter.codeExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File extensions (without dot) treated as code files.",
          "default": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "mjs",
            "cjs",
            "mts",
            "cts",
            "py",
            "pyi",
            "java",
            "kt",
            "kts",
            "scala",
            "groovy",
            "gradle",
            "c",
            "h",
            "cpp",
            "cc",
            "cxx",
            "hpp",
            "hh",
            "hxx",
            "cs",
            "fs",
            "vb",
            "go",
            "rs",
            "swift",
            "m",
            "mm",
            "dart",
            "rb",
            "php",
            "pl",
            "pm",
            "lua",
            "r",
            "jl",
            "ex",
            "exs",
            "erl",
            "hrl",
            "hs",
            "ml",
            "mli",
            "clj",
            "cljs",
            "elm",
            "zig",
            "nim",
            "sol",
            "sql",
            "sh",
            "bash",
            "zsh",
            "fish",
            "ps1",
            "psm1",
            "bat",
            "cmd",
            "html",
            "htm",
            "css",
            "scss",
            "sass",
            "less",
            "vue",
            "svelte",
            "astro",
            "json",
            "jsonc",
            "yaml",
            "yml",
            "toml",
            "xml",
            "graphql",
            "gql",
            "proto",
            "tf",
            "cmake"
          ]
        },
        "projectExporter.markdownExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "md",
            "markdown",
            "mdx"
          ],
          "description": "Extensions included when 'Include Markdown' is enabled."
        },
        "projectExporter.includeFileNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Dockerfile",
            "Makefile",
            "CMakeLists.txt",
            "Gemfile",
            "Rakefile",
            "Jenkinsfile"
          ],
          "description": "Exact file names (without extension) that should also be included."
        },
        "projectExporter.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/build/**",
            "**/bin/**",
            "**/obj/**",
            "**/target/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.svelte-kit/**",
            "**/coverage/**",
            "**/__pycache__/**",
            "**/.venv/**",
            "**/venv/**",
            "**/vendor/**",
            "**/.vscode-test/**",
            "**/.idea/**",
            "**/*.min.js",
            "**/*.min.css",
            "**/*.map",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml"
          ],
          "description": "Glob patterns to exclude."
        },
        "projectExporter.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Skip files matched by .gitignore files in the workspace."
        },
        "projectExporter.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Skip files larger than this (KB). 0 = no limit."
        },
        "projectExporter.promptForOptions": {
          "type": "boolean",
          "default": true,
          "description": "Show the options picker on every export. If false, the defaults below are used."
        },
        "projectExporter.defaults.includeMarkdown": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.defaults.syntaxHighlighting": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.defaults.minify": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.defaults.tableOfContents": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.defaults.folderStructure": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.minifyLevel": {
          "type": "string",
          "enum": [
            "collapse",
            "aggressive"
          ],
          "enumDescriptions": [
            "Every run of whitespace (including newlines) becomes a single space.",
            "Also removes spaces next to punctuation/operators ({ } ( ) ; , = etc.)."
          ],
          "default": "collapse"
        },
        "projectExporter.tabSize": {
          "type": "number",
          "default": 4
        },
        "projectExporter.pdf.pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter",
            "Legal",
            "A3"
          ],
          "default": "A4"
        },
        "projectExporter.pdf.fontSize": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 16
        },
        "projectExporter.pdf.lineNumbers": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.pdf.startEachFileOnNewPage": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.pdf.fontPath": {
          "type": "string",
          "default": "",
          "description": "Deprecated alias for projectExporter.pdf.fonts.code.path. Optional path to a monospace .ttf/.otf font (for full Unicode support, e.g. DejaVu Sans Mono)."
        },
        "projectExporter.pdf.fonts.body.family": {
          "type": "string",
          "default": "Helvetica",
          "description": "Body/prose font for analysis sections (built-in: Courier, Courier-Bold, Helvetica, Helvetica-Bold, Times-Roman, or Custom with a path)."
        },
        "projectExporter.pdf.fonts.body.path": {
          "type": "string",
          "default": "",
          "description": "Optional .ttf/.otf for the body font. Empty = use built-in family."
        },
        "projectExporter.pdf.fonts.body.size": {
          "type": "number",
          "default": 9,
          "minimum": 4,
          "maximum": 32
        },
        "projectExporter.pdf.fonts.code.family": {
          "type": "string",
          "default": "Courier",
          "description": "Monospace font for source code listings."
        },
        "projectExporter.pdf.fonts.code.path": {
          "type": "string",
          "default": "",
          "description": "Optional monospace .ttf/.otf (full Unicode). Empty = built-in Courier (Latin-1 only)."
        },
        "projectExporter.pdf.fonts.code.size": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 32
        },
        "projectExporter.pdf.fonts.heading.family": {
          "type": "string",
          "default": "Helvetica-Bold",
          "description": "Font for section headings and the title block."
        },
        "projectExporter.pdf.fonts.heading.path": {
          "type": "string",
          "default": ""
        },
        "projectExporter.pdf.fonts.heading.size": {
          "type": "number",
          "default": 14,
          "minimum": 4,
          "maximum": 32
        },
        "projectExporter.pdf.fonts.headerFooter.family": {
          "type": "string",
          "default": "Helvetica",
          "description": "Font for page headers and footers."
        },
        "projectExporter.pdf.fonts.headerFooter.path": {
          "type": "string",
          "default": ""
        },
        "projectExporter.pdf.fonts.headerFooter.size": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 32
        },
        "projectExporter.pdf.headerTemplate": {
          "type": "string",
          "default": "",
          "description": "Page header template. Empty = no header. Variables: %%PAGE%% %%PAGES%% %%PROJECT%% %%DATE%% %%TIME%% %%FILE%% %%FILECOUNT%% %%SECTION%%."
        },
        "projectExporter.pdf.footerTemplate": {
          "type": "string",
          "default": "%%PROJECT%% | Page %%PAGE%% of %%PAGES%%",
          "description": "Page footer template. Empty = no footer. Same %%VARS%% as header."
        },
        "projectExporter.pdf.sectionsPlacement": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ],
          "default": "before",
          "description": "Render analysis sections before or after the source files."
        },
        "projectExporter.clipboard.useCodeFences": {
          "type": "boolean",
          "default": true,
          "description": "Wrap each file in Markdown ``` code fences when copying to the clipboard."
        },
        "projectExporter.clipboard.headerTemplate": {
          "type": "string",
          "default": "",
          "description": "Header prepended to clipboard output. Supports %%PROJECT%% %%DATE%% %%TIME%% %%FILECOUNT%% (page vars render empty)."
        },
        "projectExporter.clipboard.footerTemplate": {
          "type": "string",
          "default": "",
          "description": "Footer appended to clipboard output. Same vars as clipboard header."
        },
        "projectExporter.sections.classList.enabled": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.sections.classList.sort": {
          "type": "string",
          "enum": [
            "alpha",
            "file",
            "folder"
          ],
          "default": "alpha"
        },
        "projectExporter.sections.classList.groupBy": {
          "type": "string",
          "enum": [
            "flat",
            "file",
            "folder"
          ],
          "default": "flat"
        },
        "projectExporter.sections.classList.showCtor": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.classList.showMethods": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.sections.classList.showFields": {
          "type": "string",
          "enum": [
            "both",
            "public",
            "private",
            "none"
          ],
          "default": "none"
        },
        "projectExporter.sections.classList.showDefaults": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.classList.showBaseClass": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.functionList.enabled": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.sections.functionList.sort": {
          "type": "string",
          "enum": [
            "alpha",
            "file",
            "folder"
          ],
          "default": "alpha"
        },
        "projectExporter.sections.functionList.groupBy": {
          "type": "string",
          "enum": [
            "flat",
            "file",
            "folder"
          ],
          "default": "flat"
        },
        "projectExporter.sections.functionList.includeMethods": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.sections.functionList.showSigs": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.functionList.showDefaults": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.usages.enabledClasses": {
          "type": "boolean",
          "default": false,
          "description": "Under each class name, list every file->line that instantiates it."
        },
        "projectExporter.sections.usages.enabledFunctions": {
          "type": "boolean",
          "default": false,
          "description": "Under each function name, list every file->line that calls it."
        },
        "projectExporter.sections.usages.contextLines": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 5
        },
        "projectExporter.sections.usages.maxHitsPerSymbol": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "projectExporter.sections.usages.skipEmpty": {
          "type": "boolean",
          "default": true,
          "description": "Skip symbols with zero usages instead of rendering an entry each."
        },
        "projectExporter.sections.usages.summarizeEmpty": {
          "type": "boolean",
          "default": true,
          "description": "Combine all skipped zero-usage symbols into a single summary line."
        },
        "projectExporter.sections.strings.enabled": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.sections.strings.sort": {
          "type": "string",
          "enum": [
            "alpha",
            "file",
            "folder"
          ],
          "default": "alpha"
        },
        "projectExporter.sections.strings.groupBy": {
          "type": "string",
          "enum": [
            "flat",
            "file"
          ],
          "default": "flat"
        },
        "projectExporter.sections.strings.minLength": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 100
        },
        "projectExporter.sections.strings.dedupe": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.strings.maxItems": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000
        },
        "projectExporter.sections.dependencies.enabled": {
          "type": "boolean",
          "default": false
        },
        "projectExporter.sections.dependencies.direction": {
          "type": "string",
          "enum": [
            "outgoing",
            "incoming",
            "both"
          ],
          "default": "outgoing"
        },
        "projectExporter.sections.dependencies.showUnresolved": {
          "type": "boolean",
          "default": true
        },
        "projectExporter.sections.placement": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ],
          "default": "before"
        },
        "projectExporter.sections.order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "classList",
            "functionList",
            "usages",
            "strings",
            "dependencies"
          ],
          "description": "Render order of analysis sections."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "ignore": "^5.3.2",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/pdfkit": "^0.13.9",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
